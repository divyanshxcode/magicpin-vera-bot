# Vera bot — environment configuration.
#
# Copy to .env for local use. NEVER commit a filled-in .env; the repo ignores
# it. On Render/Railway, set these as environment variables in the dashboard
# instead of shipping a file.
#
# This file has every value filled in except the API key. It is safe to
# commit — there is no secret in it.

# --- identity (surfaced on GET /v1/metadata) ---
# Values containing spaces are quoted so `source .env` works; a bare
# "Divyansh Singh" would be read by the shell as a command.
TEAM_NAME="Divyansh Singh"
TEAM_MEMBERS="Divyansh Singh"
CONTACT_EMAIL=divyanshsingh_23cs147@dtu.ac.in
BOT_VERSION=0.1.0

# --- LLM ---
# Unset means the deterministic grounded composer, which is correct and fully
# grounded but noticeably stiffer than the model path. The judge scored 38/50
# with the LLM live.
#
# Only one of these is a secret, and it is the single value you must supply.
#
#   LLM_PROVIDER=nous
#   LLM_API_KEY=<paste your Nous key>
#   LLM_MODEL=poolside/laguna-s-2.1:free
#
# One of: openai | anthropic | gemini | deepseek | groq | openrouter | nous
LLM_PROVIDER=nous
LLM_API_KEY=
LLM_MODEL=poolside/laguna-s-2.1:free

# Hybrid reasoning models (e.g. inclusionai/ling-3.0-flash-fin) emit a
# `reasoning` field before the answer, burning 100+ tokens on a two-sentence
# WhatsApp reply — and returning content:null when the budget runs out
# mid-thought. Measured: 129 tokens / 1.76s by default, 2 tokens / 1.14s with
# "none". Leave blank for non-reasoning models like the one above.
LLM_REASONING_EFFORT=

# Determinism is a hard judge requirement. 0.0 is the only correct value.
LLM_TEMPERATURE=0.0
# Well under the judge's 30s-per-request ceiling, since composition happens
# inside /v1/tick and /v1/reply. A full 10-action tick measures 4-12s.
LLM_TIMEOUT_S=12.0
# Wall-clock ceiling for composing one tick, against the judge 30s budget.
TICK_DEADLINE_S=20.0
LLM_MAX_TOKENS=700

# --- harness limits ---
MAX_ACTIONS_PER_TICK=20
MAX_UNANSWERED_NUDGES=3
AUTO_REPLY_FLAG_AFTER=1
AUTO_REPLY_WAIT_AFTER=2
AUTO_REPLY_END_AFTER=3
AUTO_REPLY_WAIT_SECONDS=14400

# --- python ---
# Render defaults to 3.14, where pydantic-core 2.27.2 has no prebuilt wheel and
# pip falls back to a Rust build that fails on a read-only cargo registry.
PYTHON_VERSION=3.13

# --- server ---
# Render and Railway both inject PORT. The 8080 default is for local runs only.
PORT=8080
LOG_LEVEL=info
