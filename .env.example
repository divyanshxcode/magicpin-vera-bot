# Vera bot — environment configuration.
#
# Copy to .env for local use. NEVER commit a filled-in .env; the repo ignores
# it. On Railway, set these as service variables instead of shipping a file.

# --- identity (surfaced on GET /v1/metadata) ---
TEAM_NAME=Team Alpha
TEAM_MEMBERS=Divyansh
CONTACT_EMAIL=you@example.com
BOT_VERSION=0.1.0

# --- LLM (optional — the bot runs fully without it) ---
# Leave blank to use the deterministic grounded composer.
#
#   LLM_PROVIDER=deepseek
#   LLM_API_KEY=sk-...
#   LLM_MODEL=deepseek-chat
#
# One of: openai | anthropic | gemini | deepseek | groq | openrouter
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Determinism is a hard judge requirement. 0.0 is the only correct value.
LLM_TEMPERATURE=0.0
# Well under the judge's 30s-per-request ceiling, since composition happens
# inside /v1/tick and /v1/reply.
LLM_TIMEOUT_S=12.0
LLM_MAX_TOKENS=700

# --- harness limits ---
MAX_ACTIONS_PER_TICK=20
MAX_UNANSWERED_NUDGES=3
AUTO_REPLY_FLAG_AFTER=1
AUTO_REPLY_WAIT_AFTER=2
AUTO_REPLY_END_AFTER=3
AUTO_REPLY_WAIT_SECONDS=14400

# --- server ---
PORT=8080
LOG_LEVEL=info
