# Vera bot — environment configuration.
#
# Copy to .env for local use. NEVER commit a filled-in .env; the repo ignores
# it. On Railway, set these as service variables instead of shipping a file.

# --- identity (surfaced on GET /v1/metadata) ---
TEAM_NAME=Team Alpha
TEAM_MEMBERS=Divyansh
CONTACT_EMAIL=you@example.com
BOT_VERSION=0.1.0

# --- LLM (optional — the bot runs fully without it) ---
# Leave blank to use the deterministic grounded composer.
#
#   LLM_PROVIDER=nous
#   LLM_API_KEY=sk-nous-...
#   LLM_MODEL=poolside/laguna-s-2.1:free
#   LLM_REASONING_EFFORT=none
#
# One of: openai | anthropic | gemini | deepseek | groq | openrouter | nous
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Hybrid reasoning models (e.g. inclusionai/ling-3.0-flash-fin) emit a
# `reasoning` field before the answer, burning 100+ tokens on a two-sentence
# WhatsApp reply — and returning content:null when the budget runs out
# mid-thought. Measured: 129 tokens / 1.76s by default, 2 tokens / 1.14s with
# "none". Leave blank for non-reasoning models.
LLM_REASONING_EFFORT=

# Determinism is a hard judge requirement. 0.0 is the only correct value.
LLM_TEMPERATURE=0.0
# Well under the judge's 30s-per-request ceiling, since composition happens
# inside /v1/tick and /v1/reply.
LLM_TIMEOUT_S=12.0
# Wall-clock ceiling for composing one tick, against the judge 30s budget.
TICK_DEADLINE_S=20.0
LLM_MAX_TOKENS=700

# --- harness limits ---
MAX_ACTIONS_PER_TICK=20
MAX_UNANSWERED_NUDGES=3
AUTO_REPLY_FLAG_AFTER=1
AUTO_REPLY_WAIT_AFTER=2
AUTO_REPLY_END_AFTER=3
AUTO_REPLY_WAIT_SECONDS=14400

# --- server ---
PORT=8080
LOG_LEVEL=info
